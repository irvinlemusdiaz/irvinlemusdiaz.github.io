---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Irvin Lemus Diaz">
  <section class="page-hero" style="border-bottom:none;padding-bottom:120px">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Nothing here.</h1>
      <p class="lede">That page doesn't exist, or it moved when the site got its new look.</p>
      <div class="hero-cta" style="margin-top:26px">
        <a href="/" class="btn coral">Go home →</a>
        <a href="/projects/" class="btn outline">See projects</a>
      </div>
    </div>
  </section>
</Base>
