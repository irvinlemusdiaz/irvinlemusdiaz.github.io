---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const colorClass = { blue: 'p1', coral: 'p2', lime: 'p3', ink: 'p4' }[data.color];
const num = String(index + 1).padStart(2, '0');
---

<a class={`proj ${colorClass} reveal`} data-d={String((index % 4) + 1)} href={`/projects/${project.id}/`}>
  <div class="top"><span class="num">{num}</span><span class="tag">{data.kind}</span></div>
  <div class="body">
    <h3>{data.title}</h3>
    <p>{data.summary}</p>
    <div class="stack">{data.stack.slice(0, 5).map((s) => <b>{s}</b>)}</div>
    {data.status === 'coming-soon' ? <span class="proj-soon">Coming soon</span> : <span class="proj-link">Read more →</span>}
  </div>
</a>
